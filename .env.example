# Optional. Everything here can be set on the bot's page (http://localhost:8788) instead; a value set here wins and
# shows on the page as "set by the environment". Uncomment `env_file: .env` in docker-compose.yml to use this file.

# --- Mode ---
# LIVE=0                      # 1 sends liquidations

# --- Limits ---
# MAX_REPAY_USDG=300          # the most one liquidation repays
# RESERVE_USDG=0              # USDG always left in the wallet
# MIN_PROFIT_USDG=0.25        # skip smaller liquidations (valued at the oracle price)
# ALLOW_PARTIAL=1             # liquidate part of a loan when the wallet can't cover all of it
# PAYOUT_ADDRESS=0x…          # your main wallet: seized wsNET and withdrawals go here

# --- Speed ---
# The public endpoints work but are shared and rate-limited. Your own RPC from a provider is faster:
# Chainstack, QuickNode, Blockdaemon, dRPC, Validation Cloud, GlobalStake (links in README → Speed).
# RPC_URL=https://…           # your own Robinhood Chain RPC (empty: https://rpc.mainnet.chain.robinhood.com)
# RPC_FALLBACK=1              # when your RPC fails, use the public one until it is back (0: don't)
# LOGS_RPC_URL=https://rpc.mainnet.chain.robinhood.com   # for finding borrowers, if your RPC caps eth_getLogs
# SEQUENCER_URL=https://sequencer.mainnet.chain.robinhood.com   # signed transactions also go here (off: RPC only)
# TICK_SECONDS=2

# --- NetNet Intel API ---
# INTEL_API=https://netnetintel.com/api/v1   # the open loans at start, and the market for the page (off: chain only)

# --- Logs ---
# LOG_LEVEL=debug             # a line per check in the terminal (docker logs -f netnet-liq); the page stays short
# LOG_JSON=1                  # one JSON object per line, for log collectors

# --- Telegram without the pairing (optional) ---
# TELEGRAM_BOT_TOKEN=…        # your own bot's token: deposits, liquidations and alerts go straight to TELEGRAM_CHAT_ID
# TELEGRAM_CHAT_ID=…

# --- Headless (no page) ---
# PAGE=0                      # don't start the page
# KEYSTORE_PASSWORD_FILE=/run/secrets/keystore_password   # unlock the keystore at start without the page

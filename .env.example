# Copy to .env and edit. Everything is optional except the wallet password (when the bot has a keystore).

# --- Wallet (one of these) ---
# 1. Recommended: an encrypted keystore in the data volume, made with `new-wallet` or `import-key`.
KEYSTORE_PASSWORD=
# 2. Or a raw private key. Use a wallet made for this bot only, holding only what it may spend.
# PRIVATE_KEY=

# --- Mode ---
# Off by default: the bot finds and simulates liquidations but sends nothing. Set to 1 to send.
LIVE=0

# --- Limits ---
# The most one bid repays, in USDG (empty: whatever the wallet holds).
MAX_REPAY_USDG=
# USDG always left in the wallet.
RESERVE_USDG=0
# Skip a bid that earns less than this at the oracle price, in USDG.
MIN_PROFIT_USDG=0.25
# Bid with what the wallet holds when it can't repay a whole loan.
ALLOW_PARTIAL=1
# Send each liquidation's seized wsNET to this address (your own wallet). Empty: keep it in the bot wallet.
PAYOUT_ADDRESS=

# --- Speed ---
# Your own RPC is faster and has no shared rate limits. Empty: Robinhood Chain's public RPC.
RPC_URL=
# Finding borrowers needs wide eth_getLogs ranges; some providers cap them. Empty: same as RPC_URL.
# LOGS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
TICK_SECONDS=2

# --- Alerts (optional): a Telegram bot token from @BotFather and your chat id ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

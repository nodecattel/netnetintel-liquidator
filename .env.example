# Optional. Everything here can be set on the bot's page (http://localhost:8788) instead; a value set here wins and
# shows on the page as "set by the environment". Uncomment `env_file: .env` in docker-compose.yml to use this file.

# --- Mode ---
# LIVE=0                      # 1 sends liquidations

# --- Limits ---
# MAX_REPAY_USDG=300          # the most one liquidation repays
# RESERVE_USDG=0              # USDG always left in the wallet
# MIN_PROFIT_USDG=0.25        # skip smaller liquidations (valued at the oracle price)
# ALLOW_PARTIAL=1             # liquidate part of a loan when the wallet can't cover all of it
# PAYOUT_ADDRESS=0x…          # your main wallet: seized wsNET and withdrawals go here

# --- Speed ---
# RPC_URL=https://…           # your own Robinhood Chain RPC (empty: the public one)
# LOGS_RPC_URL=https://rpc.mainnet.chain.robinhood.com   # for finding borrowers, if your RPC caps eth_getLogs
# TICK_SECONDS=2

# --- Headless (no page) ---
# PAGE=0                      # don't start the page
# KEYSTORE_PASSWORD_FILE=/run/secrets/keystore_password   # unlock the keystore at start without the page
